---
import { externalLink } from "../lib/links";
import { pageText } from "../lib/queries";
import type { Work } from "../lib/queries";
import { tagSlug } from "../lib/format";
import Cover from "./Cover.astro";

type Props = Work;

const { title, summary, context, status, topic, tags, problem, approach, link, image } = Astro.props;
const { labels } = (await pageText("work")).page;
---

<article class="work-entry" data-tags={tags.map(tagSlug).join(" ")}>
  <figure class="work-entry-media">
    <Cover topic={topic} seed={title} />
    <span class="pill">{context}</span>
  </figure>

  <div class="work-entry-body">
    <p class="work-entry-status"><span aria-hidden="true"></span>{status}</p>
    <h2>{title}</h2>
    <p class="work-entry-summary">{summary}</p>

    <div class="work-entry-detail">
      <div>
        <h3>{labels.problem}</h3>
        <p>{problem}</p>
      </div>
      <div>
        <h3>{labels.approach}</h3>
        <p>{approach}</p>
      </div>
    </div>

    {image && (
      <img class="work-entry-image" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
    )}

    <div class="work-entry-footer">
      <ul class="tag-list" aria-label={labels.tags}>
        {tags.map((tag) => <li><span class="tag-pill">#{tag}</span></li>)}
      </ul>
      {link && (
        <a class="btn btn-ghost btn-small" href={link} {...externalLink(link)}>{labels.project}</a>
      )}
    </div>
  </div>
</article>
