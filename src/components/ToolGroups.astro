---
import { getToolGroups } from "../lib/content";
import ToolChip from "./ToolChip.astro";
const groups = await getToolGroups();
---

<div class="tools">
  <div class="tool-groups">
    {groups.map((group) => (
      <div class="tool-group">
        <h3>{group.title}</h3>
        <ul class="tag-grid">
          {group.tools.map((tool, index) => <ToolChip tool={tool} index={index} />)}
        </ul>
      </div>
    ))}
  </div>
</div>
