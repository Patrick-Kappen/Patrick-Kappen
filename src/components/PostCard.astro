---
import { profile, topics, type TopicKey } from "../data/site";
import Cover from "./Cover.astro";

interface Props {
  title: string;
  topic: TopicKey;
  minutes: number;
  href?: string;
  date?: string;
  badge?: string;
  large?: boolean;
}

const { title, topic, minutes, href, date, badge, large = false } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag class:list={["post-card", { "post-card-large": large }]} href={href}>
  <figure class="post-card-media">
    <Cover topic={topic} seed={title} />
    {badge && <span class="post-badge">{badge}</span>}
  </figure>
  <div class="post-card-meta">
    <span>#{topics[topic].name}</span>
    <span class="post-time">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
      {minutes} mins read
    </span>
  </div>
  <h3>{title}</h3>
  <div class="post-card-footer">
    <img src={profile.photo} alt="" width="48" height="48" loading="lazy" />
    <span class="post-card-author">
      <strong>{profile.name.split(" ")[0]}</strong>
      <span>{date ?? "Coming soon"}</span>
    </span>
    <span class="read-more">{href ? "Read more" : "Planned"}</span>
  </div>
</Tag>
