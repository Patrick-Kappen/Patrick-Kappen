---
import { getSite, getTopicMap } from "../lib/content";
import type { Card } from "../lib/posts";
import PostDate from "./PostDate.astro";
import Cover from "./Cover.astro";

interface Props extends Card {
  badge?: string;
  large?: boolean;
}

const { title, topic, href, date, iso, note, minutes, image, description, badge, large = false } = Astro.props;
const profile = await getSite();
const topics = await getTopicMap();
const Tag = href ? "a" : "article";
---

<Tag class:list={["post-card", { "post-card-large": large }]} href={href}>
  <figure class="post-card-media">
    {image ? <img src={image} alt="" width="1600" height="640" loading="lazy" /> : <Cover topic={topic} seed={title} />}
    {badge && <span class="post-badge">{badge}</span>}
  </figure>
  <div class="post-card-meta">
    <span>#{topics[topic].name}</span>
    {minutes ? (
      <span class="post-time">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
        {minutes} min read
      </span>
    ) : (
      <span class="post-time">Planned</span>
    )}
  </div>
  <h3>{title}</h3>
  {description && <p class="post-card-excerpt">{description}</p>}
  {href && (
    <div class="post-card-footer">
      <img src={profile.photo} alt="" width="48" height="48" loading="lazy" />
      <span class="post-card-author">
        <strong>{profile.firstName}</strong>
        {date && <span><PostDate date={date} iso={iso} note={note} /></span>}
      </span>
      <span class="read-more">Read more</span>
    </div>
  )}
</Tag>
