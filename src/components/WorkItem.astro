---
import type { TopicKey } from "../data/site";
import Cover from "./Cover.astro";

interface Props {
  title: string;
  category: string;
  text: string;
  tags: string[];
  status: string;
  topic: TopicKey;
  image?: string;
  href?: string;
}

const { title, category, text, tags, status, topic, image, href } = Astro.props;
const Tag = href ? "a" : "article";
const external = href?.startsWith("http");
---

<Tag
  class="work-card"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <figure class="work-card-media">
    {image ? <img src={image} alt="" width="640" height="480" loading="lazy" /> : <Cover topic={topic} seed={title} />}
  </figure>
  <div class="work-card-body">
    <span class="pill">{category}</span>
    <h3>{title}</h3>
    <p>{text}</p>
    <div class="work-card-meta">
      <span>{tags.map((tag) => `# ${tag}`).join("   ")}</span>
      <span>{status}</span>
    </div>
  </div>
</Tag>
