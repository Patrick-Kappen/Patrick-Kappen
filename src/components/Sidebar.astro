---
import { getProjects, getSite, getTopics } from "../lib/content";
import { externalLink } from "../lib/links";
import { pageText } from "../lib/queries";
import { fill } from "../lib/text";
import { topicHref, topicsWithPosts } from "../lib/topics";

interface Props {
  home?: boolean;
  hideTopics?: boolean;
}

const { home = false, hideTopics = false } = Astro.props;
const profile = await getSite();
const openSource = await getProjects();
const topicList = await getTopics();
const { now } = profile;
const { page: layout, values } = await pageText("layout");
const labels = layout.labels;
const homelab = profile.homelab.map((fact) => ({ label: fact.label, value: fill(fact.value, values) }));
const liveTopics = await topicsWithPosts();
---

<aside class="sidebar">
  {!home && (
  <section class="widget profile-widget">
    <h2 class="widget-title">{labels.aboutMe}</h2>
    <div class="profile-row">
      <img src={profile.photo} alt="" width="72" height="72" />
      <div>
        <strong>{profile.name}</strong>
        <span>{profile.title} @ {profile.company}</span>
      </div>
    </div>
    <p>{profile.short}</p>
    <div class="profile-links">
      {profile.links.map((link) => <a href={link.href} {...externalLink(link.href)}>{link.label}</a>)}
    </div>
  </section>
  )}

  {now.now.length > 0 && (
    <section class="widget">
      <h2 class="widget-title">{labels.now}</h2>
      <ul class="now-list">
        {now.now.map((entry) => <li>{entry}</li>)}
      </ul>
    </section>
  )}

  {openSource.length > 0 && (
    <section class="widget">
      <h2 class="widget-title">{labels.openSource}</h2>
      <ul class="oss-list">
        {openSource.map((item) => (
          <li>
            <a href={item.href} {...externalLink(item.href)}>
              <span class="oss-head"><strong>{item.name}</strong><span class="oss-status">{item.status}</span></span>
              <span class="oss-text">{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {profile.certifications.length > 0 && (
    <section class="widget">
      <h2 class="widget-title">{labels.certified}</h2>
      <div class="cert-list">
        {profile.certifications.map((cert) => (cert.url ? <a class="cert" href={cert.url} title={`${cert.name}, ${cert.issued.slice(0, 4)}`}>{cert.code}</a> : <span class="cert">{cert.code}</span>))}
      </div>
    </section>
  )}

  {homelab.length > 0 && (
    <section class="widget">
      <h2 class="widget-title">{labels.homelab}</h2>
      <dl class="fact-list">
        {homelab.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
      <a class="text-link widget-link" href="/setup/#homelab">{labels.homelabLink}</a>
    </section>
  )}

  {!hideTopics && (
  <section class="widget">
    <h2 class="widget-title">{labels.writingAbout}</h2>
    <ul class="tag-list">
      {topicList.map((topic) => <li>{liveTopics.has(topic.key) ? <a class="tag-pill" href={topicHref(topic.key)}>#{topic.name}</a> : <span class="tag-pill tag-pill-muted">#{topic.name}</span>}</li>)}
    </ul>
  </section>
  )}
</aside>
