---
import now from "../../now.json";
import { profile } from "../data/site";
import { upcoming } from "../data/upcoming";
import { topics } from "../data/site";
import Cover from "./Cover.astro";
---

<aside class="sidebar">
  <section class="widget profile-widget">
    <h2 class="widget-title">About me</h2>
    <div class="profile-row">
      <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="72" height="72" />
      <div>
        <strong>{profile.name}</strong>
        <span>{profile.title} @ {profile.company}</span>
      </div>
    </div>
    <p>{profile.short}</p>
    <div class="profile-links">
      {profile.links.map((link) => (
        <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">{link.label}</a>
      ))}
    </div>
  </section>

  <section class="widget">
    <h2 class="widget-title">Up next</h2>
    <ul class="mini-posts">
      {upcoming.slice(0, 4).map((item) => (
        <li>
          <span class="mini-thumb"><Cover topic={item.topic} seed={item.title} /></span>
          <div>
            <strong>{item.title}</strong>
            <span>{item.minutes} mins read · #{topics[item.topic].name}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="widget">
    <h2 class="widget-title">Now</h2>
    <ul class="now-list">
      {now.now.map((entry) => <li>“ {entry} ”</li>)}
    </ul>
  </section>

  <section class="widget">
    <h2 class="widget-title">Certified</h2>
    <div class="cert-list">
      {profile.certifications.map((cert) => <span class="cert">{cert}</span>)}
    </div>
    <p class="muted">Studying: {profile.studying.join(" · ")}</p>
  </section>
</aside>
