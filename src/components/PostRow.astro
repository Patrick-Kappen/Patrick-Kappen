---
import { topics } from "@content/data/topics";
import type { Card } from "../lib/posts";
import Cover from "./Cover.astro";

type Props = Card;

const { title, topic, href, date, minutes, image, description } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag class="post-row" href={href}>
  <figure class="post-row-media">
    {image ? <img src={image} alt="" width="1600" height="640" loading="lazy" /> : <Cover topic={topic} seed={title} />}
  </figure>
  <div class="post-row-body">
    <p class="post-row-meta">
      {date && <span>{date}</span>}
      {minutes && <span>{minutes} min read</span>}
      <span class="post-row-topic">#{topics[topic].name}</span>
    </p>
    <h3>{title}</h3>
    {description && <p class="post-row-text">{description}</p>}
  </div>
</Tag>
