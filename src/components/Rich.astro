---
interface Props {
  text: string;
}

const parts = Astro.props.text.split(/(\*\*[^*]+\*\*|\[[^\]]+\]\([^)]+\))/).filter(Boolean);
---

{parts.map((part) => {
  if (part.startsWith("**")) return <strong>{part.slice(2, -2)}</strong>;
  const link = part.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
  if (link) return <a class="text-link" href={link[2]}>{link[1]}</a>;
  return part;
})}
