---
import "@fontsource-variable/noto-sans";
import "../styles/global.css";
import { openSource, profile } from "@content/data/profile";
import { externalLink } from "../lib/links";
import { topicKeys, topics } from "@content/data/topics";
import { topicHref, topicsWithPosts } from "../lib/topics";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = `${profile.tagline} ${profile.intro}`,
  image: imagePath = "/assets/og/default.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(imagePath, Astro.site);
const path = Astro.url.pathname;
const liveTopics = await topicsWithPosts();
const nav = [
  { label: "Blog", href: "/blog/", active: path.startsWith("/blog") },
  { label: "Work", href: "/work/", active: path.startsWith("/work") },
  { label: "Setup", href: "/setup/", active: path.startsWith("/setup") },
  { label: "About", href: "/about/", active: path.startsWith("/about") },
  { label: "Contact", href: "/contact/", active: path.startsWith("/contact") },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101217" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={profile.name} href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label={`${profile.name}, home`}>
          <span class="logo-mark" aria-hidden="true">PK</span>
          <span>{profile.firstName}</span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: item.active }} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <a class="btn btn-primary btn-small" href="/rss.xml">Subscribe</a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-panel">
          <div class="footer-brand">
            <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">PK</span><span>{profile.firstName}</span></a>
            <p>{profile.tagline}</p>
            <p class="footer-meta">{profile.title} at {profile.company} · Based in {profile.location}</p>
            <a class="footer-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
          </div>

          <div class="footer-col">
            <h2>Site</h2>
            <ul>
              <li><a href="/">Home</a></li>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href="/rss.xml">RSS feed</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h2>Topics</h2>
            <ul>
              {topicKeys.map((key) => <li>{liveTopics.has(key) ? <a href={topicHref(key)}>{topics[key].name}</a> : <span class="footer-soon">{topics[key].name}</span>}</li>)}
            </ul>
          </div>

          <div class="footer-col">
            <h2>Open source</h2>
            <ul>
              {openSource.map((item) => <li><a href={item.href} {...externalLink(item.href)}>{item.name}</a></li>)}
              <li><a href="https://github.com/Patrick-Kappen" {...externalLink("https://github.com")}>All on GitHub →</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h2>Follow along</h2>
            <ul>
              {profile.links.map((link) => (
                <li><a href={link.href} {...externalLink(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="footer-copy">© {new Date().getFullYear()} {profile.name} · Built with Astro, deployed from Git</p>
      </div>
    </footer>

    <script src="../scripts/reveal.js"></script>
  </body>
</html>
