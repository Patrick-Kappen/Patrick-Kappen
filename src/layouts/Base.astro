---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
import { profile } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Patrick Kappen — Platform & security engineer",
  description = "Patrick Kappen writes about Azure, identity, delivery and AI infrastructure: building the platforms other people deploy to, and the guard rails around them.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/assets/profile-banner-v2.png", Astro.site);
const path = Astro.url.pathname;
const nav = [
  { label: "Home", href: "/", active: path === "/" },
  { label: "Blog", href: "/blog/", active: path.startsWith("/blog") },
  { label: "About", href: "/about/", active: path.startsWith("/about") },
  { label: "Contact", href: "/about/#contact", active: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1726" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={profile.name} href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/" aria-label={`${profile.name}, home`}>
          patrick<span>.</span>kappen
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: item.active }} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <a class="button button-primary button-small" href="/rss.xml">Subscribe</a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-about">
          <a class="wordmark" href="/">patrick<span>.</span>kappen</a>
          <p>
            Notes on platforms, identity, delivery and AI infrastructure. Built with
            Astro, deployed from Git. Thanks for stopping by.
          </p>
        </div>
        <div>
          <h2>Pages</h2>
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2>Elsewhere</h2>
          <ul>
            {profile.links.map((link) => (
              <li><a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">{link.label}</a></li>
            ))}
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>© {new Date().getFullYear()} {profile.name}</p>
      </div>
    </footer>

    <script src="../scripts/reveal.js"></script>
  </body>
</html>
