---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { publishedPosts } from "../lib/posts";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Patrick Kappen — Platform & security engineer",
  description = "Patrick Kappen builds the platforms other people deploy to, and the guard rails around them: Azure, identity and delivery as code, and AI agents with boundaries.",
} = Astro.props;

const hasPosts = (await publishedPosts()).length > 0;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/assets/profile-banner-v2.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1f1d1b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Patrick Kappen" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Patrick Kappen, home">
          <span class="brand-mark" aria-hidden="true">PK</span>
          <span>Patrick Kappen</span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          <a href="/#about">About</a>
          <a href="/#focus">Focus</a>
          <a href="/#work">Work</a>
          {hasPosts && <a href="/blog/">Writing</a>}
          <a href="/#contact">Contact</a>
        </nav>

        <div class="header-links">
          <a href="https://www.linkedin.com/in/patrick-kappen/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/Patrick-Kappen" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} Patrick Kappen · <span class="footer-note">Built with Astro, deployed from Git. Thanks for stopping by.</span></p>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href="https://www.linkedin.com/in/patrick-kappen/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/Patrick-Kappen" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </footer>

    <script src="../scripts/reveal.js"></script>
  </body>
</html>
