---
import "@fontsource-variable/noto-sans";
import "../styles/global.css";
import { getProjects, getSite, getTopics } from "../lib/content";
import { externalLink } from "../lib/links";
import { pageText } from "../lib/queries";
import { topicHref, topicsWithPosts } from "../lib/topics";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const profile = await getSite();
const openSource = await getProjects();
const topics = await getTopics();
const { page: layout, f } = await pageText("layout");
const labels = layout.labels;

const {
  title = f(layout.title!),
  description = f(layout.description!),
  image: imagePath = "/assets/og/default.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(imagePath, Astro.site);
const path = Astro.url.pathname;
const liveTopics = await topicsWithPosts();
const nav = layout.nav.map((item) => ({ label: item.label, href: item.href, active: path.startsWith(item.match) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101217" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={profile.name} href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{labels.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label={f(labels.homeAria)}>
          <span class="logo-mark" aria-hidden="true">PK</span>
          <span>{profile.firstName}</span>
        </a>

        <nav class="main-nav" aria-label={labels.mainNav}>
          {nav.map((item) => (
            <a href={item.href} class:list={{ active: item.active }} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>

        <a class="btn btn-primary btn-small" href="/rss.xml">{labels.subscribe}</a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-panel">
          <div class="footer-brand">
            <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">PK</span><span>{profile.firstName}</span></a>
            <p>{profile.tagline}</p>
            <p class="footer-meta">{f(labels.based)}</p>
            <a class="footer-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
          </div>

          <div class="footer-col">
            <h2>{labels.site}</h2>
            <ul>
              <li><a href="/">{labels.home}</a></li>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a href="/rss.xml">{labels.rss}</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h2>{labels.topics}</h2>
            <ul>
              {topics.map((topic) => <li>{liveTopics.has(topic.key) ? <a href={topicHref(topic.key)}>{topic.name}</a> : <span class="footer-soon">{topic.name}</span>}</li>)}
            </ul>
          </div>

          <div class="footer-col">
            <h2>{labels.openSource}</h2>
            <ul>
              {openSource.map((item) => <li><a href={item.href} {...externalLink(item.href)}>{item.name}</a></li>)}
              <li><a href={labels.githubHref} {...externalLink("https://github.com")}>{labels.github}</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h2>{labels.follow}</h2>
            <ul>
              {profile.links.map((link) => (
                <li><a href={link.href} {...externalLink(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="footer-copy">© {new Date().getFullYear()} {profile.name} · {labels.copy}</p>
      </div>
    </footer>

    <script src="../scripts/reveal.js"></script>
  </body>
</html>
