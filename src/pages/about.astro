---
import Cover from "../components/Cover.astro";
import PageHeader from "../components/PageHeader.astro";
import Rich from "../components/Rich.astro";
import StatBand from "../components/StatBand.astro";
import { about, externalLink, openSource, profile } from "@content/data/profile";
import type { TopicKey } from "@content/data/topics";
import Base from "../layouts/Base.astro";

const facts = [
  ["Role", `${profile.title} at ${profile.company}`],
  ["Focus", about.focusLine],
  ["Studying", profile.studying.join(" · ")],
  ["Based in", profile.location],
].filter(([, value]) => value);

const toolCount = profile.stack.reduce((total, group) => total + group.tools.length, 0);
const stats = [
  { value: String(profile.certifications.length), label: "Microsoft certifications" },
  { value: String(toolCount), label: "tools in my stack" },
  { value: "4", label: "NixOS machines in one flake" },
  { value: String(openSource.length), label: "open-source projects" },
];

const focusTopics: TopicKey[] = ["delivery", "identity", "homelab", "ai"];

const elsewhere = [
  { title: "Work", text: "What I'm building right now.", href: "/work/" },
  { title: "Setup", text: "My machines, the homelab and the tools I use every day.", href: "/setup/" },
  { title: "Blog", text: "Practical notes from building all of the above.", href: "/blog/" },
];
const socials = profile.links.filter((link) => link.href.startsWith("http"));
---

<Base title={`About — ${profile.name}`} description={`${profile.name}, ${profile.title} at ${profile.company}. ${profile.tagline}`}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow="About me" title={`I'm ${profile.name}`}>
        {profile.tagline}
      </PageHeader>
    </div>

    <div class="container content-layout">
      <div class="page-main">
        <StatBand stats={stats} />

        <div class="about-story prose">
          {about.paragraphs.map((text) => <p><Rich text={text} /></p>)}
        </div>

        <div class="home-block">
          <div class="block-head">
            <h2 class="section-title">What I work on</h2>
          </div>
          <div class="focus-cards">
            {about.focus.map((item, index) => (
              <article class="focus-card">
                <figure class="focus-media">
                  <Cover topic={focusTopics[index % focusTopics.length]} seed={item.title} />
                </figure>
                <div class="focus-body">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <ul class="tag-list">
                    {item.tags.map((tag) => <li><span class="tag-pill">#{tag}</span></li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>

        {about.beliefs.length > 0 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">Things I believe</h2>
            </div>
            <ul class="row-list row-list-wide">
              {about.beliefs.map(({ title, body }) => (
                <li>
                  <strong>{title}</strong>
                  <span>{body}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="home-block">
          <div class="block-head">
            <h2 class="section-title">Elsewhere on this site</h2>
          </div>
          <ul class="link-cards">
            {elsewhere.map((item) => (
              <li>
                <a href={item.href}>
                  <strong>{item.title} →</strong>
                  <span>{item.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="page-aside">
        <section class="widget profile-card">
          <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="315" height="315" />
          <div>
            <strong>{profile.name}</strong>
            <span>{profile.role}</span>
          </div>
          <dl class="fact-list">
            {facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
          <div class="cert-list">
            {profile.certifications.map((cert) => <span class="cert">{cert}</span>)}
          </div>
        </section>

        <section class="widget">
          <h2 class="widget-title">{about.contact.title}</h2>
          <p class="widget-text">{about.contact.body}</p>
          <a class="btn btn-primary btn-block" href="/contact/">Get in touch <span aria-hidden="true">→</span></a>
          <div class="profile-links">
            {socials.map((link) => <a href={link.href} {...externalLink(link.href)}>{link.label}</a>)}
          </div>
        </section>
      </aside>
    </div>
  </section>
</Base>
