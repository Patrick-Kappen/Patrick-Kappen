---
import Cover from "../components/Cover.astro";
import PageHeader from "../components/PageHeader.astro";
import Rich from "../components/Rich.astro";
import StatBand from "../components/StatBand.astro";
import { getPage, getSite } from "../lib/content";
import Base from "../layouts/Base.astro";
import { externalLink } from "../lib/links";
import { pageText } from "../lib/queries";

const profile = await getSite();
const { page, f } = await pageText("about");
const contact = await getPage("contact");
const labels = page.labels;
const paragraphs = page.body.split(/\n\s*\n/).map((paragraph) => paragraph.trim()).filter(Boolean);
const facts = page.facts.map((fact) => [fact.label, f(fact.value)]).filter(([, value]) => value);
const stats = page.stats.map((stat) => ({ value: f(stat.value), label: stat.label }));
const socials = profile.links.filter((link) => link.href.startsWith("http"));
---

<Base title={f(page.title!)} description={f(page.description!)}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow={page.eyebrow!} title={f(page.heading!)}>
        {f(page.lead!)}
      </PageHeader>
    </div>

    <div class="container content-layout">
      <div class="page-main">
        <StatBand stats={stats} />

        <div class="about-story prose">
          {paragraphs.map((text) => <p><Rich text={text} /></p>)}
        </div>

        <div class="home-block">
          <div class="block-head">
            <h2 class="section-title">{labels.focus}</h2>
          </div>
          <div class="focus-cards">
            {page.focus.map((item) => (
              <article class="focus-card">
                <figure class="focus-media">
                  <Cover topic={item.topic} seed={item.title} />
                </figure>
                <div class="focus-body">
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <ul class="tag-list">
                    {item.tags.map((tag) => <li><span class="tag-pill">#{tag}</span></li>)}
                  </ul>
                </div>
              </article>
            ))}
          </div>
        </div>

        {page.beliefs.length > 0 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">{labels.beliefs}</h2>
            </div>
            <ul class="row-list row-list-wide">
              {page.beliefs.map(({ title, body }) => (
                <li>
                  <strong>{title}</strong>
                  <span>{body}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="home-block">
          <div class="block-head">
            <h2 class="section-title">{labels.elsewhere}</h2>
          </div>
          <ul class="link-cards">
            {page.elsewhere.map((item) => (
              <li>
                <a href={item.href}>
                  <strong>{item.title} →</strong>
                  <span>{item.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="page-aside">
        <section class="widget profile-card">
          <img src={profile.photo} alt="" width="315" height="315" />
          <div>
            <strong>{profile.name}</strong>
            <span>{profile.role}</span>
          </div>
          <dl class="fact-list">
            {facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
          <div class="cert-list">
            {profile.certifications.map((cert) => <span class="cert">{cert}</span>)}
          </div>
        </section>

        <section class="widget">
          <h2 class="widget-title">{contact.heading}</h2>
          <p class="widget-text">{contact.lead}</p>
          <a class="btn btn-primary btn-block" href="/contact/">{labels.contact} <span aria-hidden="true">→</span></a>
          <div class="profile-links">
            {socials.map((link) => <a href={link.href} {...externalLink(link.href)}>{link.label}</a>)}
          </div>
        </section>
      </aside>
    </div>
  </section>
</Base>
