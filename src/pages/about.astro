---
import Rich from "../components/Rich.astro";
import { about, externalLink, profile } from "@content/data/profile";
import { work } from "@content/data/work";
import Base from "../layouts/Base.astro";

const facts = [
  ["Role", profile.title],
  ["Company", `${profile.company}, ${profile.companyNote}`],
  ["Focus", about.focusLine],
  ["Certified", profile.certifications.join(" · ")],
  ["Based in", profile.location],
].filter(([, value]) => value);
const socials = profile.links.filter((link) => link.href.startsWith("http"));
---

<Base title={`About — ${profile.name}`} description={`${profile.name}, ${profile.title} at ${profile.company}. ${profile.tagline}`}>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <img class="page-hero-photo" src={profile.photo} alt={`Portrait of ${profile.name}`} width="140" height="140" />
      <div>
        <p class="eyebrow">About me</p>
        <h1>I'm <span class="highlight">{profile.firstName}</span>, {about.headline}</h1>
        <ul class="hero-facts">
          {facts.map(([term, value]) => (
            <li>{term} <strong>{value}</strong></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container about">
      <div class="section-head reveal">
        <p class="label">About me</p>
        <h2>A bit about me</h2>
      </div>
      <div class="about-text reveal">
        {about.paragraphs.map((text) => <p><Rich text={text} /></p>)}
      </div>
    </div>
  </section>

  {about.focus.length > 0 && (
  <section class="section section-alt" id="focus">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">Focus</p>
        <h2>Where infrastructure, identity and automation meet</h2>
        <p>That is where a manual, risky process can become a pull request.</p>
      </div>
      <div class="focus-grid">
        {about.focus.map((item) => (
          <article class="focus-item reveal">
            <span class="focus-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={item.icon}></path></svg>
            </span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="stack">{item.tags.join(" · ")}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

  {work.length > 0 && (
  <section class="section" id="work">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">Work</p>
        <h2>Selected work</h2>
        <p>What I am building at work and on my own time.</p>
      </div>
      <ul class="work-links reveal">
        {work.map((item) => (
          <li>
            <a href="/work/">
              <span class="work-context"><b>{item.context}</b>{item.status}</span>
              <strong>{item.title}</strong>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn-ghost" href="/work/">See the details on the Work page →</a>
    </div>
  </section>
)}

  {about.beliefs.length > 0 && (
  <section class="section section-alt" id="beliefs">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">Principles</p>
        <h2>Things I believe</h2>
      </div>
      <ul class="beliefs">
        {about.beliefs.map(({ title, body }) => (
          <li class="reveal">
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

  <section class="section" id="contact">
    <div class="container contact reveal">
      <p class="label">Contact</p>
      <h2>{about.contact.title}</h2>
      <p class="about-text">{about.contact.body}</p>
      <a class="contact-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="contact-links">
        {socials.map((link) => <a href={link.href} {...externalLink(link.href)}>{link.label} →</a>)}
      </div>
    </div>
  </section>
</Base>
