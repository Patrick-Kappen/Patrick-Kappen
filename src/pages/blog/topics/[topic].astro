---
import PageHeader from "../../../components/PageHeader.astro";
import PostRow from "../../../components/PostRow.astro";
import Sidebar from "../../../components/Sidebar.astro";
import { getTopicMap, getTopics, type TopicKey } from "../../../lib/content";
import Base from "../../../layouts/Base.astro";
import { blogIndex } from "../../../lib/posts";
import { pageText } from "../../../lib/queries";
import { plural } from "../../../lib/text";

export async function getStaticPaths() {
  const { published } = await blogIndex();
  return (await getTopics())
    .map((topic) => topic.key)
    .filter((key) => published.some((card) => card.topic === key))
    .map((key) => ({ params: { topic: key }, props: { topic: key } }));
}

interface Props {
  topic: TopicKey;
}

const { topic } = Astro.props;
const { published } = await blogIndex();
const posts = published.filter((card) => card.topic === topic);
const info = (await getTopicMap())[topic];
const { page, f } = await pageText("blog");
const labels = page.labels;
const count = posts.length;
const lead = f(labels.topicLead, { blurb: info.blurb, count, posts: plural(count, "post", "posts") });
---

<Base title={f(labels.topicTitle, { topic: info.name })} description={info.blurb}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow={labels.topicEyebrow} title={info.name} parent={{ label: labels.blog, href: "/blog/" }}>
        {lead}
      </PageHeader>
    </div>
    <div class="container content-layout">
      <div>
        <div class="post-rows">
          {posts.map((card) => <PostRow {...card} />)}
        </div>
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
