---
import PostCard from "../../components/PostCard.astro";
import Sidebar from "../../components/Sidebar.astro";
import { profile } from "../../data/profile";
import Base from "../../layouts/Base.astro";
import { blogIndex } from "../../lib/posts";

const { published, upcoming } = await blogIndex();
const hasPosts = published.length > 0;
---

<Base title={`Blog — ${profile.name}`} description={profile.intro}>
  <section class="section page-top">
    <div class="container content-layout">
      <div>
        <h1 class="section-title gradient-text">Blog</h1>
        <p class="section-subtitle">
          Practical write-ups from building platforms, access models and AI infrastructure.
          Follow along via <a class="text-link" href="/rss.xml">RSS</a>.
        </p>

        {hasPosts && (
          <div class="post-grid post-grid-two">
            {published.map((card) => <PostCard {...card} />)}
          </div>
        )}

        {upcoming.length > 0 && (
          <>
            <h2 class="subsection-title">{hasPosts ? "Planned next" : "Coming up"}</h2>
            <div class="post-grid post-grid-two">
              {upcoming.map((card, index) => <PostCard {...card} badge={!hasPosts && index === 0 ? "Next up" : undefined} />)}
            </div>
          </>
        )}
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
