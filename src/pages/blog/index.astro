---
import PostCard from "../../components/PostCard.astro";
import Sidebar from "../../components/Sidebar.astro";
import { upcoming } from "../../data/upcoming";
import Base from "../../layouts/Base.astro";
import { formatDate, publishedPosts, readingMinutes } from "../../lib/posts";

const posts = await publishedPosts();
const publishedTitles = new Set(posts.map((post) => post.data.title));
const planned = upcoming.filter((item) => !publishedTitles.has(item.title));
---

<Base title="Blog — Patrick Kappen" description="Practical notes on platforms, identity, delivery and AI infrastructure.">
  <section class="section page-top">
    <div class="container content-layout">
      <div>
        <h1 class="section-title gradient-text">Blog</h1>
        <p class="section-subtitle">
          Practical write-ups from building platforms, access models and AI infrastructure.
          Follow along via <a class="text-link" href="/rss.xml">RSS</a>.
        </p>

        {
          posts.length > 0 && (
            <div class="post-grid post-grid-two">
              {posts.map((post) => (
                <PostCard
                  title={post.data.title}
                  topic={post.data.topic}
                  minutes={readingMinutes(post)}
                  date={`${formatDate(post.data.date)}${post.data.draft ? " · draft" : ""}`}
                  href={`/blog/${post.id}/`}
                />
              ))}
            </div>
          )
        }

        {
          planned.length > 0 && (
            <>
              <h2 class="subsection-title">{posts.length > 0 ? "Planned next" : "Coming up"}</h2>
              <div class="post-grid post-grid-two">
                {planned.map((item, index) => (
                  <PostCard
                    title={item.title}
                    topic={item.topic}
                    minutes={item.minutes}
                    badge={index === 0 && posts.length === 0 ? "Next up" : undefined}
                  />
                ))}
              </div>
            </>
          )
        }
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
