---
import Base from "../../layouts/Base.astro";
import { formatDate, publishedPosts } from "../../lib/posts";

const posts = await publishedPosts();
---

<Base title="Writing — Patrick Kappen" description="Notes on platforms, identity, delivery and AI infrastructure.">
  <section class="section blog-index">
    <div class="container">
      <div class="section-heading reveal">
        <div>
          <p class="eyebrow">Writing</p>
          <h2>Notes from the work.</h2>
        </div>
        <p>
          What I learn while building platforms, access models and AI
          infrastructure. <a class="text-link" href="/rss.xml">RSS</a>
        </p>
      </div>

      {
        posts.length === 0 ? (
          <p class="blog-empty">The first post is on its way.</p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li class="reveal">
                <a href={`/blog/${post.id}/`}>
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                    {post.data.draft && " · draft"}
                  </time>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
