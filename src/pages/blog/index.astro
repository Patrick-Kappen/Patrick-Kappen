---
import Cover from "../../components/Cover.astro";
import { upcoming } from "../../data/upcoming";
import Base from "../../layouts/Base.astro";
import { formatDate, publishedPosts } from "../../lib/posts";

const posts = await publishedPosts();
const publishedTitles = new Set(posts.map((post) => post.data.title));
const planned = upcoming.filter((item) => !publishedTitles.has(item.title));
---

<Base title="Blog — Patrick Kappen" description="Practical notes on platforms, identity, delivery and AI infrastructure.">
  <section class="section blog-index">
    <div class="container">
      <div class="section-row">
        <div class="section-head">
          <p class="label">Blog</p>
          <h1>Notes from the work</h1>
          <p>
            Practical write-ups from building platforms, access models and AI
            infrastructure. Follow along via <a class="text-link" href="/rss.xml">RSS</a>.
          </p>
        </div>
      </div>

      {
        posts.length > 0 && (
          <div class="post-grid">
            {posts.map((post) => (
              <a class="post-card" href={`/blog/${post.id}/`}>
                <Cover seed={post.id} label={post.data.tags[0]} />
                <div class="post-card-body">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                    {post.data.draft && " · draft"}
                  </time>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        )
      }

      {
        planned.length > 0 && (
          <>
            <div class="section-head blog-planned">
              <p class="label">Coming up</p>
              <h2>{posts.length > 0 ? "Planned next" : "The first posts"}</h2>
            </div>
            <div class="post-grid">
              {planned.map((item, index) => (
                <article class="post-card post-card-upcoming">
                  <Cover seed={item.title} label={item.tag} />
                  <div class="post-card-body">
                    <span class="upcoming-badge">{index === 0 && posts.length === 0 ? "Next up" : "Planned"}</span>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>
</Base>
