---
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import PostRow from "../../components/PostRow.astro";
import Sidebar from "../../components/Sidebar.astro";
import { profile } from "@content/data/profile";
import Base from "../../layouts/Base.astro";
import { blogIndex } from "../../lib/posts";

const { published, upcoming } = await blogIndex();
const hasPosts = published.length > 0;
---

<Base title={`Blog — ${profile.name}`} description={profile.intro}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow="Blog" title="Notes from building things">
        Practical write-ups from building platforms, access models, a homelab and AI
        infrastructure. Follow along via <a class="text-link" href="/rss.xml">RSS</a>.
      </PageHeader>
    </div>
    <div class="container content-layout">
      <div>
        {hasPosts && (
          <div class="post-rows">
            {published.map((card) => <PostRow {...card} />)}
          </div>
        )}

        {upcoming.length > 0 && (
          <>
            <h2 class="subsection-title">{hasPosts ? "Planned next" : "Coming up"}</h2>
            <div class="post-grid post-grid-two">
              {upcoming.map((card, index) => <PostCard {...card} badge={!hasPosts && index === 0 ? "Next up" : undefined} />)}
            </div>
          </>
        )}
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
