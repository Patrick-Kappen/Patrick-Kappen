---
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import PostRow from "../../components/PostRow.astro";
import Sidebar from "../../components/Sidebar.astro";
import { getSite } from "../../lib/content";
import Rich from "../../components/Rich.astro";
import Base from "../../layouts/Base.astro";
import { blogIndex } from "../../lib/posts";
import { pageText } from "../../lib/queries";

const profile = await getSite();
const { page, f } = await pageText("blog");
const labels = page.labels;
const { published, upcoming } = await blogIndex(labels.draft);
const hasPosts = published.length > 0;
---

<Base title={f(page.title!)} description={profile.intro}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow={page.eyebrow!} title={page.heading!}><Rich text={page.lead!} /></PageHeader>
    </div>
    <div class="container content-layout">
      <div>
        {hasPosts && (
          <div class="post-rows">
            {published.map((card) => <PostRow {...card} />)}
          </div>
        )}

        {upcoming.length > 0 && (
          <>
            <h2 class="subsection-title">{hasPosts ? labels.planned : labels.comingUp}</h2>
            <div class="post-grid post-grid-two">
              {upcoming.map((card, index) => <PostCard {...card} badge={!hasPosts && index === 0 ? labels.nextUp : undefined} />)}
            </div>
          </>
        )}
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
