---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { render } from "astro:content";
import Cover from "../../components/Cover.astro";
import { externalLink, profile } from "@content/data/profile";
import { topics } from "@content/data/topics";
import Base from "../../layouts/Base.astro";
import { formatDate, publishedPosts, readingMinutes, seriesFor, tagSlug, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const series = await seriesFor(post);
const shareImage = existsSync(join(process.cwd(), "public/assets/og", `${post.id}.png`)) ? `/assets/og/${post.id}.png` : undefined;
const toc = headings.filter((heading) => heading.depth === 2);
const tags = post.data.tags.map((tag) => ({ name: tag, href: `/blog/tags/${tagSlug(tag)}/` }));
---

<Base title={`${post.data.title} — ${profile.name}`} description={post.data.description} image={shareImage}>
  <article class="article">
    <div class="container article-container">
      <header class="article-header">
        <p class="article-kicker">
          <a href="/blog/">Blog</a>
          <span class="kicker-line" aria-hidden="true"></span>
          <span>Posted {formatDate(post.data.date)}{post.data.draft && " · draft"}</span>
          <span>· {readingMinutes(post)} min read</span>
        </p>
        <h1>{post.data.title}</h1>
        {tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags">
            <li><a class="tag-pill tag-pill-topic" href={`/blog/topics/${post.data.topic}/`}>#{topics[post.data.topic].name}</a></li>
            {tags.map((tag) => <li><a class="tag-pill" href={tag.href}>#{tag.name}</a></li>)}
          </ul>
        )}
      </header>

      <figure class="article-cover">
        {post.data.image ? (
          <img src={post.data.image} alt={post.data.imageAlt} width="1600" height="640" />
        ) : (
          <Cover topic={post.data.topic} seed={post.data.title} />
        )}
      </figure>
      {post.data.imageCredit && (
        <p class="article-credit">
          {post.data.imageCreditUrl ? (
            <a href={post.data.imageCreditUrl} target="_blank" rel="noopener noreferrer">{post.data.imageCredit}</a>
          ) : (
            post.data.imageCredit
          )}
        </p>
      )}

      <div class="article-grid">
        {toc.length > 0 && (
          <nav class="article-toc" aria-label="On this page">
            <h2 class="widget-title">On this page</h2>
            <ol>
              {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
            </ol>
          </nav>
        )}

        <div class="article-body">
          {series && (
            <nav class="series-box" aria-label={`Series: ${series.name}`}>
              <p class="series-label">Part {series.part} of {series.parts.length} · {series.name}</p>
              <ol>
                {series.parts.map((part) => (
                  <li>{part.current ? <span aria-current="page">{part.title}</span> : <a href={part.href}>{part.title}</a>}</li>
                ))}
              </ol>
            </nav>
          )}
          <p class="article-lead">{post.data.description}</p>
          <div class="prose">
            <Content />
          </div>
          {series && (series.previous || series.next) && (
            <nav class="series-nav" aria-label="More in this series">
              {series.previous ? (
                <a href={`/blog/${series.previous.id}/`}><span>← Previous</span><strong>{series.previous.data.title}</strong></a>
              ) : <span></span>}
              {series.next && (
                <a class="series-next" href={`/blog/${series.next.id}/`}><span>Next →</span><strong>{series.next.data.title}</strong></a>
              )}
            </nav>
          )}
        </div>

        <aside class="article-aside">
          <section class="widget profile-widget">
            <h2 class="widget-title">Written by</h2>
            <div class="profile-row">
              <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="72" height="72" />
              <div>
                <strong>{profile.name}</strong>
                <span>{profile.title} @ {profile.company}</span>
              </div>
            </div>
            <p>{profile.short}</p>
            <div class="profile-links">
              {profile.links.map((link) => <a href={link.href} {...externalLink(link.href)}>{link.label}</a>)}
            </div>
          </section>

          {tags.length > 0 && (
            <section class="widget">
              <h2 class="widget-title">Tags</h2>
              <ul class="tag-list">
                {tags.map((tag) => <li><a class="tag-pill" href={tag.href}>#{tag.name}</a></li>)}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </div>
  </article>
</Base>
