---
import PageHeader from "../../../components/PageHeader.astro";
import PostRow from "../../../components/PostRow.astro";
import Sidebar from "../../../components/Sidebar.astro";
import Base from "../../../layouts/Base.astro";
import { postDate, postsByTag, readingMinutes, type Post } from "../../../lib/posts";
import { pageText } from "../../../lib/queries";
import { plural } from "../../../lib/text";

export async function getStaticPaths() {
  const tags = await postsByTag();
  return [...tags].map(([tag, entry]) => ({ params: { tag }, props: entry }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
const { page, f } = await pageText("blog");
const labels = page.labels;
const count = posts.length;
---

<Base title={f(labels.tagTitle, { tag: name })} description={f(labels.tagDescription, { tag: name })}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow={labels.tagEyebrow} title={`#${name}`} parent={{ label: labels.blog, href: "/blog/" }}>
        {f(labels.tagLead, { count, posts: plural(count, "post", "posts") })}
      </PageHeader>
    </div>
    <div class="container content-layout">
      <div>
        <div class="post-rows">
          {posts.map((post) => (
            <PostRow
              title={post.data.title}
              topic={post.data.topic}
              href={`/blog/${post.id}/`}
              date={postDate(post, labels.draft)}
              minutes={readingMinutes(post)}
              image={post.data.image}
              description={post.data.description}
            />
          ))}
        </div>
      </div>
      <Sidebar />
    </div>
  </section>
</Base>
