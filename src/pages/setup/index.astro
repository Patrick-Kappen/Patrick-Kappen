---
import Cover from "../../components/Cover.astro";
import MachineCard from "../../components/MachineCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import StatBand from "../../components/StatBand.astro";
import ToolGroups from "../../components/ToolGroups.astro";
import { desk, lab, labServices } from "@content/data/hardware";
import { profile } from "@content/data/profile";
import type { TopicKey } from "@content/data/topics";
import Base from "../../layouts/Base.astro";
import { homelabFacts, toolCount } from "../../lib/queries";

const labStats = homelabFacts().stats;
const sections: { id: string; label: string; topic: TopicKey; text: string }[] = [
  { id: "desk", label: "Desk", topic: "workstation", text: "The machines I work on every day." },
  { id: "homelab", label: "Homelab", topic: "homelab", text: "Where ideas get tested before they reach real work." },
  { id: "tools", label: "Tools", topic: "containers", text: `${toolCount} tools, at work and at home.` },
];
const banner = (id: string) => sections.find((section) => section.id === id)!;
---

<Base title={`Setup — ${profile.name}`} description={`The machines, homelab and tools ${profile.firstName} uses at work and at home.`}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow="Setup" title="What I use and run">
        The machines on my desk, the homelab where ideas get tested before they reach
        real work, and the tools I reach for every day.
      </PageHeader>
    </div>

    <div class="container content-layout">
      <div class="page-main">
        <StatBand stats={[...labStats, { value: String(toolCount), label: "tools" }]} />

        {["desk", "homelab", "tools"].map((id) => {
          const section = banner(id);
          return (
            <section class="setup-section" id={id}>
              <div class="section-banner">
                <Cover topic={section.topic} seed={`setup ${id}`} />
                <div class="section-banner-text">
                  <h2>{section.label}</h2>
                  <p>{section.text}</p>
                </div>
              </div>

              {id === "desk" && desk.map((group) => (
                <div class="setup-group">
                  <h3 class="group-title">{group.title}</h3>
                  <div class="machine-grid">
                    {group.machines.map((machine) => <MachineCard {...machine} />)}
                  </div>
                </div>
              ))}

              {id === "homelab" && (
                <>
                  <p class="setup-lead">
                    I run it like production: every machine is declared in Git and rebuilt from code.
                    Right now I'm turning it into a Kubernetes cluster on NixOS, and I write about it
                    on the <a class="text-link" href="/blog/">blog</a> as I go.
                  </p>
                  {lab.map((group) => (
                    <div class="setup-group">
                      <h3 class="group-title">{group.title}</h3>
                      <div class="machine-grid">
                        {group.machines.map((machine) => <MachineCard {...machine} />)}
                      </div>
                    </div>
                  ))}
                  <div class="setup-group">
                    <h3 class="group-title">What runs on it</h3>
                    <dl class="row-list">
                      {labServices.map((service) => (
                        <div>
                          <dt>{service.area}</dt>
                          <dd>{service.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </>
              )}

              {id === "tools" && (
                <div class="setup-group">
                  <ToolGroups />
                </div>
              )}
            </section>
          );
        })}
      </div>

      <aside class="page-aside">
        <section class="widget">
          <h2 class="widget-title">On this page</h2>
          <ol class="aside-nav">
            {sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>
                  <strong>{section.label}</strong>
                  <span>{section.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
        <section class="widget">
          <h2 class="widget-title">Follow the build</h2>
          <p class="widget-text">I write about the homelab and the move to Kubernetes as it happens.</p>
          <div class="profile-links">
            <a href="/blog/">Blog</a>
            <a href="/rss.xml">RSS</a>
          </div>
        </section>
      </aside>
    </div>
  </section>
</Base>
