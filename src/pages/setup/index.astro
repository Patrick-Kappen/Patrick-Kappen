---
import Cover from "../../components/Cover.astro";
import MachineCard from "../../components/MachineCard.astro";
import PageHeader from "../../components/PageHeader.astro";
import Rich from "../../components/Rich.astro";
import StatBand from "../../components/StatBand.astro";
import ToolGroups from "../../components/ToolGroups.astro";
import { getServices } from "../../lib/content";
import Base from "../../layouts/Base.astro";
import { machineGroups, pageText } from "../../lib/queries";

const { page, f } = await pageText("setup");
const labels = page.labels;
const desk = await machineGroups("desk");
const lab = await machineGroups("lab");
const labServices = await getServices();
const stats = page.stats.map((stat) => ({ value: f(stat.value), label: stat.label }));
const sections = page.sections.map((section) => ({ ...section, text: f(section.text) }));
const banner = (id: string) => sections.find((section) => section.id === id)!;
---

<Base title={f(page.title!)} description={f(page.description!)}>
  <section class="section page-top">
    <div class="container">
      <PageHeader eyebrow={page.eyebrow!} title={page.heading!}>{page.lead}</PageHeader>
    </div>

    <div class="container content-layout">
      <div class="page-main">
        <StatBand stats={stats} />

        {sections.map(({ id }) => {
          const section = banner(id);
          return (
            <section class="setup-section" id={id}>
              <div class="section-banner">
                <Cover topic={section.topic} seed={`setup ${id}`} />
                <div class="section-banner-text">
                  <h2>{section.label}</h2>
                  <p>{section.text}</p>
                </div>
              </div>

              {id === "desk" && desk.map((group) => (
                <div class="setup-group">
                  <h3 class="group-title">{group.title}</h3>
                  <div class="machine-grid">
                    {group.machines.map((machine) => <MachineCard {...machine} />)}
                  </div>
                </div>
              ))}

              {id === "homelab" && (
                <>
                  <p class="setup-lead"><Rich text={labels.homelabLead} /></p>
                  {lab.map((group) => (
                    <div class="setup-group">
                      <h3 class="group-title">{group.title}</h3>
                      <div class="machine-grid">
                        {group.machines.map((machine) => <MachineCard {...machine} />)}
                      </div>
                    </div>
                  ))}
                  <div class="setup-group">
                    <h3 class="group-title">{labels.services}</h3>
                    <dl class="row-list">
                      {labServices.map((service) => (
                        <div>
                          <dt>{service.area}</dt>
                          <dd>{service.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </>
              )}

              {id === "tools" && (
                <div class="setup-group">
                  <ToolGroups />
                </div>
              )}
            </section>
          );
        })}
      </div>

      <aside class="page-aside">
        <section class="widget">
          <h2 class="widget-title">{labels.onThisPage}</h2>
          <ol class="aside-nav">
            {sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>
                  <strong>{section.label}</strong>
                  <span>{section.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
        <section class="widget">
          <h2 class="widget-title">{labels.follow}</h2>
          <p class="widget-text">{labels.followText}</p>
          <div class="profile-links">
            <a href="/blog/">{labels.blog}</a>
            <a href="/rss.xml">{labels.rss}</a>
          </div>
        </section>
      </aside>
    </div>
  </section>
</Base>
