---
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
import { pageText } from "../lib/queries";

const { page, f } = await pageText("404");
---

<Base title={f(page.title!)} description={page.description}>
  <section class="section page-top">
    <div class="container not-found">
      <PageHeader eyebrow={page.eyebrow!} title={page.heading!}>{page.lead}</PageHeader>
      <div class="cta-actions">
        {page.actions.map((action) => <a class={action.primary ? "btn btn-primary" : "btn btn-ghost"} href={action.href}>{action.label}</a>)}
      </div>
    </div>
  </section>
</Base>
