---
import PageHeader from "../../components/PageHeader.astro";
import { getSite } from "../../lib/content";
import { externalLink } from "../../lib/links";
import Base from "../../layouts/Base.astro";
import { pageText } from "../../lib/queries";

const profile = await getSite();
const { page, f } = await pageText("contact");
const labels = page.labels;
const socials = profile.links.filter((link) => link.href.startsWith("http"));
---

<Base title={f(page.title!)} description={f(page.description!)}>
  <section class="section page-top">
    <div class="container contact-page">
      <div>
        <PageHeader eyebrow={page.eyebrow!} title={page.heading!}>{page.lead}</PageHeader>
        <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="cta-actions">
          {socials.map((link) => <a class="btn btn-ghost" href={link.href} {...externalLink(link.href)}>{link.label}</a>)}
          <a class="btn btn-ghost" href="/rss.xml">{labels.rss}</a>
        </div>
      </div>
      <div>
        <h2 class="group-title">{labels.reasons}</h2>
        <ul class="row-list row-list-stacked">
          {page.reasons.map((reason) => (
            <li>
              <strong>{reason.title}</strong>
              <span>{reason.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>
