---
import Cover from "../components/Cover.astro";
import PostRow from "../components/PostRow.astro";
import Sidebar from "../components/Sidebar.astro";
import ToolChip from "../components/ToolChip.astro";
import WorkItem from "../components/WorkItem.astro";
import { profile } from "@content/data/profile";
import { topicKeys, topics } from "@content/data/topics";
import { featuredWork } from "@content/data/work";
import Base from "../layouts/Base.astro";
import { blogIndex } from "../lib/posts";

const { published } = await blogIndex();
const latest = published.slice(0, 5);
const recentWork = featuredWork.slice(0, 3);
const allTools = profile.stack.flatMap((group) => group.tools);
const toolCount = allTools.length;
const highlights = profile.highlights
  .map((name) => allTools.find((tool) => tool.name === name))
  .filter((tool) => tool !== undefined);

const topicList = topicKeys
  .map((key) => ({
    key,
    ...topics[key],
    count: published.filter((card) => card.topic === key).length,
  }))
  .filter((topic) => topic.count > 0);
const showTopics = topicList.length >= 3;
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <img class="hero-avatar" src={profile.photo} alt={`Portrait of ${profile.name}`} width="315" height="315" />
      <div class="hero-copy">
        <p class="hero-eyebrow">{profile.role}</p>
        <h1>I'm <span class="gradient-text">{profile.name}</span></h1>
        <p class="hero-text">
          {profile.title} at {profile.company}. {profile.tagline} {profile.intro}
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#latest">Read the blog <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="/about/">About me</a>
        </div>
      </div>
    </div>

    {showTopics && (
      <div class="container">
        <div class="topics-panel">
          <div class="topics-intro">
            <h2>Topics</h2>
            <p>What I write about, from the day job at an {profile.companyNote} and from my homelab.</p>
            <div class="slider-controls">
              <button type="button" class="slider-btn" data-slide="prev" aria-label="Previous topics">←</button>
              <button type="button" class="slider-btn" data-slide="next" aria-label="Next topics">→</button>
            </div>
          </div>
          <ul class="topics-slider" data-slider>
            {topicList.map((topic) => (
              <li>
                <a class="topic-card" href={`/blog/topics/${topic.key}/`}>
                  <Cover topic={topic.key} seed={`${topic.name} topic`} />
                  <span class="topic-card-text">
                    <strong>{topic.name}</strong>
                    <span>{topic.count} {topic.count === 1 ? "post" : "posts"}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </section>

  <section class="section" id="latest">
    <div class="container content-layout content-layout-aligned">
      <div class="home-main">
        {profile.stack.length > 0 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">What I work with</h2>
              <a class="text-link" href="/setup/#tools">All {toolCount} tools →</a>
            </div>
            <div class="tools">
              <ul class="tag-grid tool-highlights">
                {highlights.map((tool, index) => <ToolChip tool={tool} index={index} />)}
              </ul>
            </div>
          </div>
        )}

        {latest.length > 0 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">Latest posts</h2>
              <a class="text-link" href="/blog/">All posts →</a>
            </div>
            <div class="post-rows">
              {latest.map((card) => <PostRow {...card} />)}
            </div>
          </div>
        )}

        {recentWork.length > 1 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">Recent work</h2>
              <a class="text-link" href="/work/">All work →</a>
            </div>
            <div class="work-list">
              {recentWork.map((item) => <WorkItem {...item} />)}
            </div>
          </div>
        )}

      </div>
      <Sidebar />
    </div>
  </section>

  <script src="../scripts/slider.js"></script>
</Base>
