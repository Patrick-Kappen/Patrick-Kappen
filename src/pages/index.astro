---
import Cover from "../components/Cover.astro";
import PostCard from "../components/PostCard.astro";
import Sidebar from "../components/Sidebar.astro";
import { profile, topics, type TopicKey } from "../data/site";
import { upcoming } from "../data/upcoming";
import Base from "../layouts/Base.astro";
import { formatDate, publishedPosts, readingMinutes } from "../lib/posts";

const posts = await publishedPosts();
const publishedTitles = new Set(posts.map((post) => post.data.title));
const planned = upcoming.filter((item) => !publishedTitles.has(item.title));

const topicCounts = Object.keys(topics).map((key) => {
  const topic = key as TopicKey;
  return {
    key: topic,
    ...topics[topic],
    published: posts.filter((post) => post.data.topic === topic).length,
    planned: planned.filter((item) => item.topic === topic).length,
  };
});
---

<Base>
  <section class="hero">
    <span class="deco deco-cross deco-cross-1" aria-hidden="true"></span>
    <span class="deco deco-cross deco-cross-2" aria-hidden="true"></span>
    <span class="deco deco-dot deco-dot-1" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow enter">Hello everyone 👋</p>
        <h1 class="enter">I'm <span class="highlight">Patrick Kappen</span></h1>
        <p class="hero-lead enter">
          {profile.title} at {profile.company}. I build the platforms other people
          deploy to, and the guard rails around them. This is where I write about
          Azure, identity, delivery and AI infrastructure, and what I learn along the way.
        </p>
        <div class="hero-actions enter">
          <a class="button button-primary" href="#latest">Read the blog</a>
          <a class="button" href="/about/">About me</a>
        </div>
      </div>
      <div class="hero-portrait enter">
        <span class="portrait-ring" aria-hidden="true"></span>
        <img src={profile.photo} alt={`Portrait of ${profile.name}`} width="315" height="315" />
        <span class="portrait-chip portrait-chip-1">Azure</span>
        <span class="portrait-chip portrait-chip-2">Nix</span>
        <span class="portrait-chip portrait-chip-3">AI agents</span>
      </div>
    </div>
  </section>

  <section class="topics-band">
    <div class="container topics-layout">
      <div class="topics-intro reveal">
        <h2>Topics</h2>
        <p>What I write about, from the day job and from my homelab.</p>
      </div>
      <div class="topics-grid">
        {topicCounts.map((topic) => (
          <a class="topic-card reveal" href="/blog/">
            <Cover topic={topic.key} seed={topic.name} />
            <span class="topic-card-text">
              <strong>{topic.name}</strong>
              <span>
                {topic.published > 0
                  ? `${topic.published} ${topic.published === 1 ? "post" : "posts"}`
                  : `${topic.planned} planned`}
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="latest">
    <div class="container blog-layout">
      <div class="blog-main">
        <div class="section-title reveal">
          <h2>{posts.length > 0 ? "Latest posts" : "Coming up"}</h2>
          <p>
            {posts.length > 0
              ? "Practical notes from building platforms and AI infrastructure."
              : "The first posts are being written. Follow along via RSS."}
          </p>
        </div>

        <div class="post-grid">
          {posts.map((post, index) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              topic={post.data.topic}
              minutes={readingMinutes(post)}
              date={formatDate(post.data.date)}
              href={`/blog/${post.id}/`}
              featured={index === 0}
            />
          ))}
          {planned.map((item, index) => (
            <PostCard
              title={item.title}
              description={item.description}
              topic={item.topic}
              minutes={item.minutes}
              badge={index === 0 && posts.length === 0 ? "Next up" : "Planned"}
              featured={index === 0 && posts.length === 0}
            />
          ))}
        </div>
      </div>

      <Sidebar />
    </div>
  </section>
</Base>
