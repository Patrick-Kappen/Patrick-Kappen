---
import now from "../../now.json";
import Base from "../layouts/Base.astro";
import { formatDate, publishedPosts } from "../lib/posts";

const posts = (await publishedPosts()).slice(0, 3);
const nowChanged = new Date(`${now.updated}T00:00:00Z`).toLocaleDateString("en-GB", {
  month: "long",
  year: "numeric",
});

const facts = [
  ["Role", "Senior DevOps Engineer"],
  ["Company", "SLTN, Azure Expert MSP"],
  ["Focus", "Azure platform, identity and delivery as code"],
  ["Certified", "AZ-900 · AZ-104 · AZ-400"],
  ["Based in", "the Netherlands"],
];

const focus = [
  {
    title: "Platform & delivery",
    body: "Azure environments and landing zones defined in code, pipelines without stored secrets, and every change planned and approved before it is applied.",
    tags: ["Azure", "Terraform", "Bicep", "GitHub Actions"],
  },
  {
    title: "Identity & security",
    body: "Least-privilege access across customer tenants, just-in-time elevation instead of standing admin rights, and security policy turned into automation.",
    tags: ["Entra ID", "PIM", "OIDC", "Zero Trust"],
  },
  {
    title: "AI infrastructure",
    body: "Open models benchmarked and tuned as coding agents, and agents that work inside sandboxes with scoped access and human approval.",
    tags: ["vLLM", "LiteLLM", "Python", "Sandboxing"],
  },
];

const cases = [
  {
    title: "GitHub and secret-free pipelines",
    summary: "Moving a whole organisation to GitHub, with OIDC instead of stored secrets.",
    context: "At SLTN",
    status: "In progress",
    problem: "Pipelines spread across Azure DevOps, with long-lived service principal secrets to store and rotate.",
    approach: "Moving repositories and pipelines to GitHub, replacing stored secrets with OIDC workload identity, and managing governance as code.",
  },
  {
    title: "Least-privilege access across tenants",
    summary: "Just-in-time access for customer tenants, defined in code.",
    context: "At SLTN",
    status: "In progress",
    problem: "Managing many customer tenants tends to accumulate broad, permanent admin rights.",
    approach: "Scoped, delegated access with just-in-time elevation and approval, defined in Terraform together with the CISO.",
  },
  {
    title: "Disaster recovery you can prove",
    summary: "Automated recovery tests that show the machines really come back.",
    context: "At SLTN",
    status: "In use",
    problem: "Recovery plans existed, but testing them was manual, slow and therefore rare.",
    approach: "Automated test failovers in GitHub Actions that check machines come up and can reach each other, report the result and always clean up.",
  },
  {
    title: "Open models as coding agents",
    summary: "Choosing and tuning open models on measured numbers.",
    context: "Personal research",
    status: "Ongoing",
    problem: "Model choices for agentic coding are usually based on leaderboards, not on the actual workload.",
    approach: "My own benchmarks for tool calling, long agent tasks, long context and concurrent agents, with vLLM serving tuned on measured numbers.",
  },
  {
    title: "Graft",
    summary: "Containers from a few lines of TOML, built by Nix.",
    context: "Open source",
    status: "Alpha",
    problem: "Containers on NixOS hosts need hand-written systemd units and ad-hoc package installs.",
    approach: "A few lines of TOML; Nix builds the root filesystem and generates the Podman Quadlet units.",
    link: "https://github.com/Patrick-Kappen/graft",
  },
  {
    title: "Homelab & NixOS fleet",
    summary: "Where ideas get tested before they reach real work.",
    context: "Personal",
    status: "Running",
    problem: "Ideas need a place to be tested properly before they reach real work.",
    approach: "Proxmox, Talos Kubernetes and GitOps with 3-2-1 backups and monitoring; my own machines are a NixOS fleet rebuilt from Git with signed commits.",
  },
];

const beliefs = [
  ["If it isn't in Git, it doesn't exist.", "Portal clicks are drift with extra steps. If it matters, it is versioned and reviewed."],
  ["A backup you haven't restored is a rumour.", "Recovery is tested on a schedule, or it isn't really there."],
  ["Standing admin access is a bug.", "People, pipelines and agents get just enough rights, just in time, and lose them again."],
  ["AI agents get the intern treatment.", "A sandbox, a reviewer and no production keys. Useful work, inside clear boundaries."],
];
---

<Base>
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <p class="label enter">Platform &amp; security engineer</p>
        <h1 class="enter">
          I build the platforms other people deploy to, <span>and the guard rails around them.</span>
        </h1>
        <p class="enter">
          Environments rebuilt from code, access no broader than it needs to be,
          and changes someone reviews before they land. Lately that includes
          letting AI agents do real work without handing them the keys.
        </p>
        <div class="hero-actions enter">
          <a class="button button-primary" href="#work">See my work</a>
          <a class="button" href="#contact">Get in touch</a>
        </div>
      </div>
      <ul class="hero-facts enter">
        {facts.map(([term, value]) => (
          <li>{term} <strong>{value}</strong></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="focus">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">Focus</p>
        <h2>Where infrastructure, identity and automation meet</h2>
        <p>That is where a manual, risky process can become a pull request.</p>
      </div>
      <div class="focus-grid">
        {focus.map((item, index) => (
          <article class="focus-item reveal">
            <span class="index">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <p class="stack">{item.tags.join(" · ")}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="work">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">Work</p>
        <h2>Selected work</h2>
        <p>What I am building at work and on my own time. Open a row for the details.</p>
      </div>
      <div class="work-list reveal">
        {cases.map((item) => (
          <details class="work-item">
            <summary>
              <span class="work-context"><b>{item.context}</b>{item.status}</span>
              <span class="work-title">
                <strong>{item.title}</strong>
                <span>{item.summary}</span>
              </span>
              <span class="work-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="work-detail">
              <span></span>
              <div>
                <h4>Problem</h4>
                <p>{item.problem}</p>
              </div>
              <div>
                <h4>Approach</h4>
                <p>{item.approach}</p>
              </div>
              {item.link && (
                <a class="text-link" href={item.link} target="_blank" rel="noopener noreferrer">
                  View on GitHub →
                </a>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="now">
    <div class="container split">
      <div class="reveal">
        <div class="section-head">
          <p class="label live">Now</p>
          <h2>What I'm working on</h2>
        </div>
        <ul class="now-list">{now.now.map((entry) => <li>{entry}</li>)}</ul>
        <p class="muted now-updated">Last changed {nowChanged}.</p>
      </div>
      <div class="reveal">
        <div class="section-head">
          <p class="label">Writing</p>
          <h2>Notes from the work</h2>
        </div>
        {
          posts.length > 0 ? (
            <ul class="post-list">
              {posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">The first post, on moving pipelines from secrets to OIDC, is on its way.</p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section-alt" id="beliefs">
    <div class="container">
      <div class="section-head reveal">
        <p class="label">Principles</p>
        <h2>Things I believe</h2>
      </div>
      <ul class="beliefs">
        {beliefs.map(([title, body]) => (
          <li class="reveal">
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container contact reveal">
      <p class="label">Contact</p>
      <h2>Let's talk about platforms, identity or AI infrastructure.</h2>
      <a class="contact-mail" href="mailto:patrick@kappen.io">patrick@kappen.io</a>
      <div class="contact-links">
        <a href="https://www.linkedin.com/in/patrick-kappen/" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
        <a href="https://github.com/Patrick-Kappen" target="_blank" rel="noopener noreferrer">GitHub →</a>
      </div>
    </div>
  </section>
</Base>
