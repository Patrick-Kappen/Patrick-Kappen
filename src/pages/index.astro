---
import Cover from "../components/Cover.astro";
import PostRow from "../components/PostRow.astro";
import Sidebar from "../components/Sidebar.astro";
import ToolChip from "../components/ToolChip.astro";
import WorkItem from "../components/WorkItem.astro";
import { getSite, getToolGroups } from "../lib/content";
import Base from "../layouts/Base.astro";
import { blogIndex } from "../lib/posts";
import { featuredWork, highlightTools, pageText, topicsWithCounts } from "../lib/queries";

const profile = await getSite();
const { page, f } = await pageText("home");
const labels = page.labels;
const [headingBefore, headingAfter] = page.heading!.split("{name}");
const toolGroups = await getToolGroups();
const { published } = await blogIndex();
const latest = published.slice(0, 5);
const recentWork = (await featuredWork()).slice(0, 3);
const highlights = await highlightTools();

const topicList = (await topicsWithCounts(published)).filter((topic) => topic.count > 0);
const showTopics = topicList.length >= 3;
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <img class="hero-avatar" src={profile.photo} alt={`Portrait of ${profile.name}`} width="315" height="315" />
      <div class="hero-copy reveal">
        <p class="hero-eyebrow">{f(page.eyebrow!)}</p>
        <h1>{headingBefore}<span class="gradient-text">{profile.name}</span>{headingAfter}</h1>
        <p class="hero-text">
          {f(page.lead!)}
        </p>
        <div class="hero-actions">
          {page.actions.map((action) => (
            <a class={action.primary ? "btn btn-primary" : "btn btn-ghost"} href={action.href}>{action.label}{action.arrow && <> <span aria-hidden="true">→</span></>}</a>
          ))}
        </div>
      </div>
    </div>

    {showTopics && (
      <div class="container">
        <div class="topics-panel">
          <div class="topics-intro">
            <h2>{labels.topics}</h2>
            <p>{f(labels.topicsLead)}</p>
            <div class="slider-controls">
              <button type="button" class="slider-btn" data-slide="prev" aria-label={labels.previous}>←</button>
              <button type="button" class="slider-btn" data-slide="next" aria-label={labels.next}>→</button>
            </div>
          </div>
          <ul class="topics-slider" data-slider>
            {topicList.map((topic) => (
              <li>
                <a class="topic-card" href={`/blog/topics/${topic.key}/`}>
                  <Cover topic={topic.key} seed={`${topic.name} topic`} />
                  <span class="topic-card-text">
                    <strong>{topic.name}</strong>
                    <span>{topic.count} {topic.count === 1 ? "post" : "posts"}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </section>

  <section class="section" id="latest">
    <div class="container content-layout content-layout-aligned">
      <div class="home-main">
        {toolGroups.length > 0 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">{labels.tools}</h2>
              <a class="text-link" href="/setup/#tools">{f(labels.allTools)}</a>
            </div>
            <div class="tools">
              <ul class="tag-grid tool-highlights">
                {highlights.map((tool, index) => <ToolChip tool={tool} index={index} />)}
              </ul>
            </div>
          </div>
        )}

        {latest.length > 0 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">{labels.latest}</h2>
              <a class="text-link" href="/blog/">{labels.allPosts}</a>
            </div>
            <div class="post-rows">
              {latest.map((card) => <PostRow {...card} />)}
            </div>
          </div>
        )}

        {recentWork.length > 1 && (
          <div class="home-block">
            <div class="block-head">
              <h2 class="section-title">{labels.work}</h2>
              <a class="text-link" href="/work/">{labels.allWork}</a>
            </div>
            <div class="work-list">
              {recentWork.map((item) => <WorkItem {...item} />)}
            </div>
          </div>
        )}

      </div>
      <Sidebar home hideTopics={showTopics} />
    </div>
  </section>

  <script src="../scripts/slider.js"></script>
  <script src="../scripts/reveal.js"></script>
</Base>
