{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "patrickkappen",
  "compatibility_date": "2026-07-14",
  "routes": [
    {
      "pattern": "patrick.kappen.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
